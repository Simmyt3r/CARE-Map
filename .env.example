DATABASE_URL=postgresql://avnadmin:password@host:port/defaultdb?sslmode=require
AIVEN_CA_CERT=
SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional: stable HMAC key for shared rate limits (32+ characters); defaults to SESSION_SECRET.
# RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-seeding
NEXT_PUBLIC_APP_NAME=CARE-Map
# Neutral global branding is the default. Configure a region only after approving its GIS data.
# NEXT_PUBLIC_CAREMAP_REGION_NAME=Example Region
# NEXT_PUBLIC_CAREMAP_REGION_DATA_APPROVED=true
# NEXT_PUBLIC_CAREMAP_MAP_LONGITUDE=0
# NEXT_PUBLIC_CAREMAP_MAP_LATITUDE=0
# NEXT_PUBLIC_CAREMAP_MAP_ZOOM=6
# Cloudinary image storage: keep all three keys server-side only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Historical Vercel Blob URLs are still supported for previously uploaded photos.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_SH_BASE_URL=https://sh.dataspace.copernicus.eu
EARTH_SEARCH_STAC_URL=https://earth-search.aws.element84.com/v1
DATA_CONTROLLER_NAME=
DATA_CONTROLLER_ADDRESS=
PRIVACY_CONTACT_EMAIL=
PRIVACY_LAWFUL_BASIS_REPORTS=
PRIVACY_LAWFUL_BASIS_ACCOUNTS=
PRIVACY_LEGAL_REVIEWED_AT=
PRIVACY_REVIEWER=
